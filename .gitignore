# ============================================================
#  Unity generated / cache folders
# ============================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data — only ignore meta of ignored folders above
!/[Aa]ssets/**/*.meta

# Unity3D generated meta files for explicitly ignored folders
/[Aa]ssets/[Ss]treamingAssets/*.meta

# ============================================================
#  IDE / project files (auto-generated by Unity)
# ============================================================
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# ============================================================
#  Builds / packages / binaries
# ============================================================
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ============================================================
#  OS / misc
# ============================================================
.DS_Store
sysinfo.txt
.gradle/

# ============================================================
#  Unity AI Assistant local settings (per-machine)
# ============================================================
/[Pp]roject[Ss]ettings/[Pp]ackages/com.unity.ai.assistant/

# ============================================================
#  Claude Code (per-machine local settings)
# ============================================================
.claude/settings.local.json
# Skill docs auto-generated from the connected Unity MCP tools
.claude/skills/

# ============================================================
#  Unity MCP bridge — auto-restored dev tooling (not game content)
# ============================================================
# Assets/Plugins currently holds only the NuGet DLLs restored by the
# com.IvanMurzak.McpPlugin UPM package (regenerated on demand, not referenced
# by Quantall.Runtime). Ignore the whole folder + its meta. If real game
# plugins are ever added here, narrow this back to /Assets/Plugins/NuGet/.
/[Aa]ssets/[Pp]lugins/
/[Aa]ssets/[Pp]lugins.meta
